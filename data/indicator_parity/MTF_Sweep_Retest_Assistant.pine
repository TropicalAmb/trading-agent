//@version=6
indicator("MTF Sweep Retest Assistant", overlay=true, max_labels_count=500)

// ===== Inputs =====
tf1 = input.timeframe("15", "TF 1")
tf2 = input.timeframe("60", "TF 2")
tf3 = input.timeframe("240", "TF 3")

useLiveHTF = input.bool(true, "Use Live HTF Candle State")
useVWAP = input.bool(true, "Use VWAP Filter")

showBox = input.bool(true, "Show Info Box")
showBiasMarkers = input.bool(true, "Show Bias Markers")
showPDLevels = input.bool(true, "Show Previous Day High/Low")
showSweepMarkers = input.bool(true, "Show Sweep Markers")
showSetupMarkers = input.bool(true, "Show Setup Markers")
showEntryMarkers = input.bool(true, "Show Entry Markers")
showBG = input.bool(false, "Show Background Bias")
showOnlyFirstSignal = input.bool(false, "Show Only First Signal")

fastLen = input.int(20, "Fast EMA")
slowLen = input.int(50, "Slow EMA")

retestZoneATR = input.float(0.15, "Retest Zone Size (ATR)", step=0.05)
sweepValidBars = input.int(240, "How Long Sweep Stays Valid (bars)", minval=1, maxval=2000)

// ===== Core values =====
fastEMA = ta.ema(close, fastLen)
slowEMA = ta.ema(close, slowLen)
vwapVal = ta.vwap(close)
atrVal = ta.atr(14)

// ===== Previous day levels =====
pdh = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_off)
pdl = request.security(syminfo.tickerid, "D", low[1], lookahead=barmerge.lookahead_off)

// ===== HTF display labels =====
tfDisplay(tf) =>
    result = tf
    if tf == "15"
        result := "15-minute"
    else if tf == "60"
        result := "1-hour"
    else if tf == "240"
        result := "4-hour"
    result

// ===== HTF current candle state =====
getHTFState(tf) =>
    float o = na
    float c = na

    if useLiveHTF
        o := request.security(syminfo.tickerid, tf, open, lookahead=barmerge.lookahead_off)
        c := request.security(syminfo.tickerid, tf, close, lookahead=barmerge.lookahead_off)
    else
        o := request.security(syminfo.tickerid, tf, open[1], lookahead=barmerge.lookahead_off)
        c := request.security(syminfo.tickerid, tf, close[1], lookahead=barmerge.lookahead_off)

    result = 0
    if c > o
        result := 1
    else if c < o
        result := -1
    result

s1 = getHTFState(tf1)
s2 = getHTFState(tf2)
s3 = getHTFState(tf3)

stateText(x) =>
    txt = "Neutral"
    if x == 1
        txt := "Bullish Now"
    else if x == -1
        txt := "Bearish Now"
    txt

stateColor(x) =>
    c = color.orange
    if x == 1
        c := color.lime
    else if x == -1
        c := color.red
    c

// ===== Bias =====
allBullNow = s1 == 1 and s2 == 1 and s3 == 1
allBearNow = s1 == -1 and s2 == -1 and s3 == -1

vwapBull = close > vwapVal
vwapBear = close < vwapVal

longBias = allBullNow
shortBias = allBearNow

if useVWAP
    longBias := allBullNow and vwapBull
    shortBias := allBearNow and vwapBear

// ===== Sweep detection =====
shortSweep = high > pdh and close < pdh
longSweep = low < pdl and close > pdl

var int lastShortSweepBar = na
var int lastLongSweepBar = na
var float shortSweepHigh = na
var float longSweepLow = na

if shortSweep
    lastShortSweepBar := bar_index
    shortSweepHigh := high

if longSweep
    lastLongSweepBar := bar_index
    longSweepLow := low

shortSweepActive = not na(lastShortSweepBar) and (bar_index - lastShortSweepBar <= sweepValidBars)
longSweepActive = not na(lastLongSweepBar) and (bar_index - lastLongSweepBar <= sweepValidBars)

// ===== Retest setup logic =====
shortRetestZone = high >= pdh - atrVal * retestZoneATR and high <= pdh + atrVal * retestZoneATR
longRetestZone = low <= pdl + atrVal * retestZoneATR and low >= pdl - atrVal * retestZoneATR

shortSetup = shortSweepActive and shortRetestZone and close < pdh
longSetup = longSweepActive and longRetestZone and close > pdl

// ===== Entry logic =====
sellNow = shortBias and shortSetup and close < open and close < low[1]
buyNow = longBias and longSetup and close > open and close > high[1]

newSell = sellNow and not sellNow[1]
newBuy = buyNow and not buyNow[1]

// ===== Display mode =====
biasLongMarker = showBiasMarkers ? (showOnlyFirstSignal ? (longBias and not longBias[1]) : longBias) : false
biasShortMarker = showBiasMarkers ? (showOnlyFirstSignal ? (shortBias and not shortBias[1]) : shortBias) : false

shortSweepMarker = showSweepMarkers ? (showOnlyFirstSignal ? (shortSweep and not shortSweep[1]) : shortSweep) : false
longSweepMarker = showSweepMarkers ? (showOnlyFirstSignal ? (longSweep and not longSweep[1]) : longSweep) : false

shortSetupMarker = showSetupMarkers ? (showOnlyFirstSignal ? (shortSetup and not shortSetup[1]) : shortSetup) : false
longSetupMarker = showSetupMarkers ? (showOnlyFirstSignal ? (longSetup and not longSetup[1]) : longSetup) : false

sellMarker = showEntryMarkers ? (showOnlyFirstSignal ? newSell : sellNow) : false
buyMarker = showEntryMarkers ? (showOnlyFirstSignal ? newBuy : buyNow) : false

// ===== Confidence percentage =====
score = 0

if s1 == 1
    score += 20
else if s1 == -1
    score -= 20

if s2 == 1
    score += 20
else if s2 == -1
    score -= 20

if s3 == 1
    score += 20
else if s3 == -1
    score -= 20

if useVWAP
    if vwapBull
        score += 20
    else if vwapBear
        score -= 20

if close > fastEMA and fastEMA > slowEMA
    score += 20
else if close < fastEMA and fastEMA < slowEMA
    score -= 20

bullPct = math.round((score + 100) / 2.0)
bullPct := math.max(0, math.min(100, bullPct))

confText = str.tostring(bullPct) + "%"
confColor = color.orange
if bullPct > 50
    confColor := color.lime
else if bullPct < 50
    confColor := color.red

// ===== Action text =====
actionText = "Wait"
actionColor = color.orange

if buyNow
    actionText := "Buy Now"
    actionColor := color.lime
else if sellNow
    actionText := "Sell Now"
    actionColor := color.red
else if longSetup
    actionText := "Watching Long Retest"
    actionColor := color.new(color.lime, 10)
else if shortSetup
    actionText := "Watching Short Retest"
    actionColor := color.new(color.red, 10)
else if longBias
    actionText := "Long Bias"
    actionColor := color.lime
else if shortBias
    actionText := "Short Bias"
    actionColor := color.red

// ===== HTF refresh timer =====
sec1 = timeframe.in_seconds(tf1)
sec2 = timeframe.in_seconds(tf2)
sec3 = timeframe.in_seconds(tf3)

barStart1 = time(tf1)
barStart2 = time(tf2)
barStart3 = time(tf3)

close1 = barStart1 + sec1 * 1000
close2 = barStart2 + sec2 * 1000
close3 = barStart3 + sec3 * 1000

left1 = math.max(close1 - timenow, 0)
left2 = math.max(close2 - timenow, 0)
left3 = math.max(close3 - timenow, 0)

minLeft = math.min(left1, math.min(left2, left3))
totalSec = int(math.floor(minLeft / 1000))
mins = int(math.floor(totalSec / 60))
secs = int(totalSec % 60)
refreshText = str.format("{0}:{1,number,00}", mins, secs)

// ===== Static info box =====
var table info = table.new(position.top_right, 2, 8, border_width=1)

if barstate.islast and showBox
    table.cell(info, 0, 0, "Timeframe", text_color=color.white, bgcolor=color.black)
    table.cell(info, 1, 0, "State", text_color=color.white, bgcolor=color.black)

    table.cell(info, 0, 1, tfDisplay(tf1), text_color=color.white, bgcolor=color.rgb(35, 35, 35))
    table.cell(info, 1, 1, stateText(s1), text_color=stateColor(s1), bgcolor=color.rgb(35, 35, 35))

    table.cell(info, 0, 2, tfDisplay(tf2), text_color=color.white, bgcolor=color.rgb(35, 35, 35))
    table.cell(info, 1, 2, stateText(s2), text_color=stateColor(s2), bgcolor=color.rgb(35, 35, 35))

    table.cell(info, 0, 3, tfDisplay(tf3), text_color=color.white, bgcolor=color.rgb(35, 35, 35))
    table.cell(info, 1, 3, stateText(s3), text_color=stateColor(s3), bgcolor=color.rgb(35, 35, 35))

    vwapText = "Off"
    vwapTextColor = color.gray
    if useVWAP
        if vwapBull
            vwapText := "Bull"
            vwapTextColor := color.lime
        else if vwapBear
            vwapText := "Bear"
            vwapTextColor := color.red
        else
            vwapText := "Flat"
            vwapTextColor := color.orange

    table.cell(info, 0, 4, "VWAP", text_color=color.white, bgcolor=color.black)
    table.cell(info, 1, 4, vwapText, text_color=vwapTextColor, bgcolor=color.black)

    table.cell(info, 0, 5, "Action", text_color=color.white, bgcolor=color.black)
    table.cell(info, 1, 5, actionText, text_color=actionColor, bgcolor=color.black)

    table.cell(info, 0, 6, "Confidence", text_color=color.white, bgcolor=color.black)
    table.cell(info, 1, 6, confText, text_color=confColor, bgcolor=color.black)

    table.cell(info, 0, 7, "HTF Refresh", text_color=color.white, bgcolor=color.black)
    table.cell(info, 1, 7, refreshText, text_color=color.aqua, bgcolor=color.black)

// ===== Chart-attached plots =====
plot(fastEMA, "Fast EMA", color=color.aqua, linewidth=2)
plot(slowEMA, "Slow EMA", color=color.orange, linewidth=2)
plot(useVWAP ? vwapVal : na, "VWAP", color=color.purple, linewidth=2)

plot(showPDLevels ? pdh : na, "Previous Day High", color=color.red, linewidth=2, style=plot.style_linebr)
plot(showPDLevels ? pdl : na, "Previous Day Low", color=color.blue, linewidth=2, style=plot.style_linebr)

// Bias markers
plotshape(biasLongMarker, title="Long Bias Marker", style=shape.triangleup, location=location.belowbar, color=color.lime, size=size.tiny, text="LB")
plotshape(biasShortMarker, title="Short Bias Marker", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.tiny, text="SB")

// Sweep markers
plotshape(longSweepMarker, title="PDL Sweep", style=shape.circle, location=location.belowbar, color=color.blue, size=size.tiny, text="PDL SWEEP")
plotshape(shortSweepMarker, title="PDH Sweep", style=shape.circle, location=location.abovebar, color=color.red, size=size.tiny, text="PDH SWEEP")

// Setup markers
plotshape(longSetupMarker, title="Long Setup", style=shape.circle, location=location.belowbar, color=color.green, size=size.tiny, text="LONG SETUP")
plotshape(shortSetupMarker, title="Short Setup", style=shape.circle, location=location.abovebar, color=color.maroon, size=size.tiny, text="SHORT SETUP")

// Entry markers
plotshape(buyMarker, title="Buy Now", style=shape.labelup, location=location.belowbar, color=color.lime, text="BUY NOW", textcolor=color.black, size=size.small)
plotshape(sellMarker, title="Sell Now", style=shape.labeldown, location=location.abovebar, color=color.red, text="SELL NOW", textcolor=color.white, size=size.small)

bgcolor(showBG ? color.new(actionColor, 90) : na)

// ===== Alerts =====
alertcondition(buyMarker, title="Buy Now", message="Buy Now")
alertcondition(sellMarker, title="Sell Now", message="Sell Now")
alertcondition(longSetupMarker, title="Watching Long Retest", message="Watching Long Retest")
alertcondition(shortSetupMarker, title="Watching Short Retest", message="Watching Short Retest")
</user_query>