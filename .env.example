# Copy to .env and fill in values. Never commit .env.

# paper | live  (live requires explicit confirmation flag below)
TRADING_MODE=paper

# Must be set to true to allow live orders (ignored in paper mode)
ALLOW_LIVE_TRADING=false

# Paper VPS / local: force mock broker (no live orders)
USE_MOCK_BROKER=true

# tradovate (Topstep) | ibkr | mock via --mock flag
BROKER_BACKEND=ibkr

# ===== Tradovate / Topstep (preferred for MES/MNQ) =====
TRADOVATE_DEMO=true
TRADOVATE_USERNAME=
TRADOVATE_PASSWORD=
TRADOVATE_APP_ID=Sample App
TRADOVATE_APP_VERSION=0.0.1
TRADOVATE_DEVICE_ID=trading-agent-pc
TRADOVATE_CID=
TRADOVATE_SEC=
TRADOVATE_ACCOUNT_ID=
TRADOVATE_ACCOUNT_SPEC=

# ===== Optional IBKR (not required if you use Tradovate) =====
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_CLIENT_ID=1

# Anthropic (optional advisor)
ANTHROPIC_API_KEY=

# Optional alerts (leave empty to disable)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# TradingView -> agent webhook (set the same secret in TV alert URL)
WEBHOOK_SECRET=change-me-to-a-long-random-string

# Paths
CONFIG_PATH=config/settings.yaml
JOURNAL_DB_PATH=data/journal.db
